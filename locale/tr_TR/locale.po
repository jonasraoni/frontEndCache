msgid "plugins.generic.frontEndCache.name"
msgstr "Ön yüz önbellek eklentisi"

msgid "plugins.generic.frontEndCache.description"
msgstr "Bu eklenti, uygulamanın ana sayfalarına önbellek ekler."

msgid "plugins.generic.frontEndCache.general"
msgstr "Genel ayarlar"

msgid "plugins.generic.frontEndCache.useCacheHeader"
msgstr "Önbellek başlığı kullan: etkinleştirildiğinde, eklenti tarayıcıya önbellek başlıkları gönderir"

msgid "plugins.generic.frontEndCache.useCompression"
msgstr "Sıkıştırma kullan: Etkinleştirildiğinde, eklenti gzip kullanarak içeriği sıkıştırmaya çalışacaktır"

msgid "plugins.generic.frontEndCache.useStatistics"
msgstr "İstatistikleri kullan: Etkinleştirildiğinde, eklenti önbelleğe alınmış bir sayfa sunarken uygulama istatistiklerini güncellemeye çalışacaktır"

msgid "plugins.generic.frontEndCache.cacheCss"
msgstr "CSS önbelleği: Etkinleştirildiğinde, eklenti dinamik CSS içeriğini önbelleğe alacaktır"

msgid "plugins.generic.frontEndCache.timeToLiveInSeconds"
msgstr "Her önbelleğe alınmış sayfanın yaşam süresi (saniye): Bu süre sonunda önbelleğe alınmış sayfa geçersiz sayılacak ve yeniden oluşturulacaktır"

msgid "plugins.generic.frontEndCache.cacheablePages"
msgstr "Eklentiye hangi sayfaların önbelleğe alınacağını belirten öneklerin listesi"

msgid "plugins.generic.frontEndCache.nonCacheableOperations"
msgstr "Önbelleğin etkinleştirilmemesi gereken sayfalar/işlemler listesi"

msgid "plugins.generic.frontEndCache.clearCacheInstruction"
msgstr "Önbelleğini temizlemek istediğiniz bağlamları seçin"

msgid "plugins.generic.frontEndCache.sharedContent"
msgstr "Paylaşılan sayfalar"

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "Cache Kuralları"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "İçeriği yalnızca ilgili varlıklar değiştirildiğinde sona erdiren akıllı cache kuralları tanımlayın. Her kural, bir rota deseni (regex) ve bütünlük hash'i döndüren bir SQL sorgusu içerir."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "Rota Deseni"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "SQL Sorgusu"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "Rotaları eşleştirmek için düzenli ifade (örn. #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "Tek satır ve sütun döndürmeli, bütünlük hash'i olarak kullanılır. Mevcut değişkenler: $1..$n (yakalanan gruplara erişim için), $contextId, $userId, $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "Varsayılan Kuralları Sıfırla"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "Cache kuralları varsayılan değerlere sıfırlandı."
