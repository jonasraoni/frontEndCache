msgid "plugins.generic.frontEndCache.name"
msgstr "Front-End Cache Plugin-a"

msgid "plugins.generic.frontEndCache.description"
msgstr "Plugin honek cache-a gehitzen dio aplikazioaren orri nagusiei."

msgid "plugins.generic.frontEndCache.general"
msgstr "Ezarpen orokorrak"

msgid "plugins.generic.frontEndCache.useCacheHeader"
msgstr "Erabili cache goiburua: gaitutakoan, pluginak cache goiburuak bidaliko dizkio nabigatzaileari"

msgid "plugins.generic.frontEndCache.useCompression"
msgstr "Erabili konpresioa: Gaitutakoan, pluginak gzip erabiliz konprimitu egingo du edukia"

msgid "plugins.generic.frontEndCache.useStatistics"
msgstr "Erabili estatistikak: Gaitutakoan, pluginak aplikazioaren estatistikak eguneratuko ditu cache orri bat zerbitzatzean"

msgid "plugins.generic.frontEndCache.cacheCss"
msgstr "Cache CSS: Gaitutakoan, pluginak CSS edukia cache-an gordeko du"

msgid "plugins.generic.frontEndCache.timeToLiveInSeconds"
msgstr "Cache orri baten bizitza segundutan: Denbora hau igaro ondoren, cache orria baliogabetu eta berriro sortuko da"

msgid "plugins.generic.frontEndCache.cacheablePages"
msgstr "Pluginari zein orri cache-an gorde behar diren adierazteko aurrizkien zerrenda"

msgid "plugins.generic.frontEndCache.nonCacheableOperations"
msgstr "Cache-a ez gaitu behar diren orri/eragiketen zerrenda"

msgid "plugins.generic.frontEndCache.clearCacheInstruction"
msgstr "Hautatu cache-a garbitu nahi duzun testuingurua"

msgid "plugins.generic.frontEndCache.sharedContent"
msgstr "Partekatutako orriak"

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "Cache Arauak"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "Definitu cache arau adimentsuak edukiak soilik erlazionatutako entitateak aldatzen direnean iraungitzen dutenak. Arau bakoitzak ibilbide patroi bat (regex) eta integritate hash bat itzultzen duen SQL kontsulta bat ditu."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "Ibilbide Patroia"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "SQL Kontsulta"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "Ibilbideekin bat etortzeko adierazpen erregularra (adib. #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "Lerro eta zutabe bakarra itzuli behar du, integritate hash gisa erabiltzen da. Aldagai erabilgarriak: $1..$n (harrapatutako taldeetara sartzeko), $contextId, $userId, $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "Berrezarri Lehenetsitako Arauak"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "Cache arauak lehenetsitako balioetara berrezarri dira."
