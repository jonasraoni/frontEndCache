msgid "plugins.generic.frontEndCache.name"
msgstr "پلاگین کش فرانت-اند"

msgid "plugins.generic.frontEndCache.description"
msgstr "این پلاگین کش را به صفحات اصلی برنامه اضافه می‌کند."

msgid "plugins.generic.frontEndCache.general"
msgstr "تنظیمات عمومی"

msgid "plugins.generic.frontEndCache.useCacheHeader"
msgstr "استفاده از هدر کش: وقتی فعال باشد، پلاگین هدرهای کش را به مرورگر ارسال می‌کند"

msgid "plugins.generic.frontEndCache.useCompression"
msgstr "استفاده از فشرده‌سازی: وقتی فعال باشد، پلاگین سعی می‌کند محتوا را با gzip فشرده کند"

msgid "plugins.generic.frontEndCache.useStatistics"
msgstr "استفاده از آمار: وقتی فعال باشد، پلاگین سعی می‌کند آمار برنامه را هنگام سرویس دهی صفحه کش شده به‌روز کند"

msgid "plugins.generic.frontEndCache.cacheCss"
msgstr "کش CSS: وقتی فعال باشد، پلاگین محتوای CSS پویا را کش می‌کند"

msgid "plugins.generic.frontEndCache.timeToLiveInSeconds"
msgstr "زمان زنده ماندن هر صفحه کش شده بر حسب ثانیه: پس از این زمان، صفحه کش شده باطل شده و مجددا تولید می‌شود"

msgid "plugins.generic.frontEndCache.cacheablePages"
msgstr "فهرست پیشوندها برای راهنمایی پلاگین که کدام صفحات باید کش شوند"

msgid "plugins.generic.frontEndCache.nonCacheableOperations"
msgstr "فهرست صفحات/عملیاتی که نباید برای آنها کش فعال شود"

msgid "plugins.generic.frontEndCache.clearCacheInstruction"
msgstr "زمینه‌هایی را که می‌خواهید کش آنها پاک شود انتخاب کنید"

msgid "plugins.generic.frontEndCache.sharedContent"
msgstr "صفحات مشترک"

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "قوانین کش"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "قوانین هوشمند کش را تعریف کنید که محتوا را فقط زمانی منقضی می‌کند که موجودیت‌های مرتبط تغییر کنند. هر قانون شامل الگوی مسیر (regex) و پرس‌وجوی SQL است که هش یکپارچگی را برمی‌گرداند."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "الگوی مسیر"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "پرس‌وجوی SQL"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "عبارت منظم برای تطبیق مسیرها (مثال: #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "باید یک ردیف و ستون واحد برگرداند، به عنوان هش یکپارچگی استفاده می‌شود. متغیرهای موجود: $1..$n (برای دسترسی به گروه‌های ضبط شده)، $contextId، $userId، $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "بازنشانی قوانین پیش‌فرض"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "قوانین کش به مقادیر پیش‌فرض بازنشانی شدند."
