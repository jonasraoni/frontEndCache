msgid "plugins.generic.frontEndCache.name"
msgstr "Front-end-välimuistilisäosa"

msgid "plugins.generic.frontEndCache.description"
msgstr "Tämä lisäosa lisää välimuistin sovelluksen pääsivuille."

msgid "plugins.generic.frontEndCache.general"
msgstr "Yleiset asetukset"

msgid "plugins.generic.frontEndCache.useCacheHeader"
msgstr "Käytä välimuistin otsaketta: kun käytössä, lisäosa lähettää välimuistin otsakkeet selaimelle"

msgid "plugins.generic.frontEndCache.useCompression"
msgstr "Käytä pakkausta: Kun käytössä, lisäosa yrittää pakata sisällön käyttäen gzipiä"

msgid "plugins.generic.frontEndCache.useStatistics"
msgstr "Käytä tilastoja: Kun käytössä, lisäosa yrittää päivittää sovelluksen tilastoja välimuistisivua tarjoillessa"

msgid "plugins.generic.frontEndCache.cacheCss"
msgstr "Välimuisti CSS: Kun käytössä, lisäosa tallentaa dynaamisen CSS-sisällön välimuistiin"

msgid "plugins.generic.frontEndCache.timeToLiveInSeconds"
msgstr "Välimuistisivun elinikä sekunteina: Tämän ajan kuluttua välimuistisivu mitätöidään ja luodaan uudelleen"

msgid "plugins.generic.frontEndCache.cacheablePages"
msgstr "Etuliitteiden luettelo, joka ohjaa lisäosaa siihen, mitkä sivut tulisi tallentaa välimuistiin"

msgid "plugins.generic.frontEndCache.nonCacheableOperations"
msgstr "Sivujen/toimintojen luettelo, joille välimuistia ei saa käyttää"

msgid "plugins.generic.frontEndCache.clearCacheInstruction"
msgstr "Valitse kontekstit, joiden välimuistin haluat tyhjentävän"

msgid "plugins.generic.frontEndCache.sharedContent"
msgstr "Jaetut sivut"

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "Välimuistin Säännöt"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "Määritä älykkäät välimuistin säännöt, jotka vanhentavat sisällön vain kun liittyvät entiteetit muuttuvat. Jokainen sääntö koostuu reittimallista (regex) ja SQL-kyselystä, joka palauttaa eheys-hashin."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "Reittimalli"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "SQL-kysely"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "Säännöllinen lauseke reittien vastaamiseen (esim. #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "Pitäisi palauttaa yksi rivi ja sarake, käytetään eheys-hashina. Saatavilla olevat muuttujat: $1..$n (pääsy siepatuille ryhmille), $contextId, $userId, $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "Nollaa Oletussäännöt"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "Välimuistin säännöt on nollattu oletusarvoihin."
