msgid "plugins.generic.frontEndCache.name"
msgstr "Előtér-gyorsítótár bővítmény"

msgid "plugins.generic.frontEndCache.description"
msgstr "Ez a bővítmény gyorsítótárat ad az alkalmazás fő oldalaihoz."

msgid "plugins.generic.frontEndCache.general"
msgstr "Általános beállítások"

msgid "plugins.generic.frontEndCache.useCacheHeader"
msgstr "Gyorsítótár fejléc használata: ha engedélyezve van, a bővítmény gyorsítótár fejléceket küld a böngészőnek"

msgid "plugins.generic.frontEndCache.useCompression"
msgstr "Tömörítés használata: Ha engedélyezve van, a bővítmény megpróbálja tömöríteni a tartalmat gzip segítségével"

msgid "plugins.generic.frontEndCache.useStatistics"
msgstr "Statisztikák használata: Ha engedélyezve van, a bővítmény megpróbálja frissíteni az alkalmazás statisztikáit gyorsítótárazott oldal kiszolgálásakor"

msgid "plugins.generic.frontEndCache.cacheCss"
msgstr "CSS gyorsítótár: Ha engedélyezve van, a bővítmény gyorsítótárazza a dinamikus CSS tartalmat"

msgid "plugins.generic.frontEndCache.timeToLiveInSeconds"
msgstr "Minden gyorsítótárazott oldal élettartama másodpercben: Ez idő elteltével az oldal érvénytelenítésre kerül és újragenerálódik"

msgid "plugins.generic.frontEndCache.cacheablePages"
msgstr "Előtagok listája, amelyek segítségével a bővítmény megtudja, mely oldalakat kell gyorsítótárazni"

msgid "plugins.generic.frontEndCache.nonCacheableOperations"
msgstr "Azon oldalak/műveletek listája, ahol a gyorsítótár nem engedélyezett"

msgid "plugins.generic.frontEndCache.clearCacheInstruction"
msgstr "Válassza ki azokat a környezeteket, amelyeknél törölni szeretné a gyorsítótárat"

msgid "plugins.generic.frontEndCache.sharedContent"
msgstr "Megosztott oldalak"

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "Cache Szabályok"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "Definiáljon okos cache szabályokat, amelyek csak akkor érvénytelenítik a tartalmat, amikor a kapcsolódó entitások módosulnak. Minden szabály egy útvonal mintából (regex) és egy SQL lekérdezésből áll, amely integritási hash-t ad vissza."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "Útvonal Minta"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "SQL Lekérdezés"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "Reguláris kifejezés útvonalak egyeztetéséhez (pl. #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "Egyetlen sort és oszlopot kell visszaadnia, integritási hash-ként használva. Elérhető változók: $1..$n (a rögzített csoportok eléréséhez), $contextId, $userId, $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "Alapértelmezett Szabályok Visszaállítása"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "A cache szabályok visszaálltak az alapértelmezett értékekre."
