msgid "plugins.generic.frontEndCache.name"
msgstr "Плагин кеширования фронтенда"

msgid "plugins.generic.frontEndCache.description"
msgstr "Этот плагин добавляет кеширование для основных страниц приложения."

msgid "plugins.generic.frontEndCache.general"
msgstr "Общие настройки"

msgid "plugins.generic.frontEndCache.useCacheHeader"
msgstr "Использовать заголовки кеша: при включении плагин будет отправлять заголовки кеша браузеру"

msgid "plugins.generic.frontEndCache.useCompression"
msgstr "Использовать сжатие: При включении плагин будет пытаться сжимать контент с помощью gzip"

msgid "plugins.generic.frontEndCache.useStatistics"
msgstr "Использовать статистику: При включении плагин будет пытаться обновлять статистику приложения при отдаче закешированной страницы"

msgid "plugins.generic.frontEndCache.cacheCss"
msgstr "Кешировать CSS: При включении плагин будет кешировать динамический CSS-контент"

msgid "plugins.generic.frontEndCache.timeToLiveInSeconds"
msgstr "Время жизни каждой закешированной страницы в секундах: По истечении этого времени страница будет считаться недействительной и перегенерирована"

msgid "plugins.generic.frontEndCache.cacheablePages"
msgstr "Список префиксов для указания плагину, какие страницы следует кешировать"

msgid "plugins.generic.frontEndCache.nonCacheableOperations"
msgstr "Список страниц/операций, для которых не следует включать кеширование"

msgid "plugins.generic.frontEndCache.clearCacheInstruction"
msgstr "Выберите контексты, для которых нужно очистить кеш"

msgid "plugins.generic.frontEndCache.sharedContent"
msgstr "Общие страницы"

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "Правила Кэша"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "Определите умные правила кэша, которые истекают содержимое только при изменении связанных сущностей. Каждое правило состоит из шаблона маршрута (regex) и SQL-запроса, который возвращает хэш целостности."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "Шаблон Маршрута"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "SQL Запрос"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "Регулярное выражение для сопоставления маршрутов (например, #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "Должен возвращать одну строку и один столбец, используется как хэш целостности. Доступные переменные: $1..$n (для доступа к захваченным группам), $contextId, $userId, $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "Сбросить Правила по Умолчанию"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "Правила кэша были сброшены к значениям по умолчанию."

msgid "plugins.generic.frontEndCache.cacheRules"
msgstr "Правила Кеширования"

msgid "plugins.generic.frontEndCache.cacheRulesDescription"
msgstr "Определите интеллектуальные правила кеширования, которые истекают контент только при изменении связанных сущностей. Каждое правило состоит из шаблона маршрута (regex) и SQL-запроса, который возвращает хеш целостности."

msgid "plugins.generic.frontEndCache.cacheRulePattern"
msgstr "Шаблон Маршрута"

msgid "plugins.generic.frontEndCache.cacheRuleQuery"
msgstr "SQL-Запрос"

msgid "plugins.generic.frontEndCache.cacheRulePatternHelp"
msgstr "Регулярное выражение для сопоставления маршрутов (например, #issue/view/(\d+)#)"

msgid "plugins.generic.frontEndCache.cacheRuleQueryHelp"
msgstr "Должен возвращать одну строку и один столбец, используемые как хеш целостности. Доступные переменные: $1..$n (для доступа к захваченным группам), $contextId, $userId, $locale."

msgid "plugins.generic.frontEndCache.resetRules"
msgstr "Сбросить Правила по Умолчанию"

msgid "plugins.generic.frontEndCache.rulesReset"
msgstr "Правила кеширования были сброшены к значениям по умолчанию."
